{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "assignees": ["mkoelle"],
  "helmValues": [
    {
      "fileMatch": ["apps/**/values\\.yaml"]
    }
  ],
  "kubernetes": [
    {
      "fileMatch": ["apps/**/*.yaml", "bootstrap/**/*.yaml"]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["helmv3", "helm-values"],
      "groupName": "helm charts",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": false
    },
    {
      "matchDepTypes": ["container"],
      "groupName": "container images",
      "automerge": false
    },
    {
      "matchPackageNames": ["alpine/k8s"],
      "groupName": "k8s tooling",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["Taskfile\\.yml"],
      "matchStrings": [
        "[A-Z_]+_IMAGE: (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["apps/core/argocd/kustomization\\.yaml"],
      "matchStrings": [
        "ref=(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    }
  ]
}
